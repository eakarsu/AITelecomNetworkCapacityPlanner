NODE_ENV=development
BACKEND_PORT=4000
CLIENT_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001
DB_HOST=localhost
DB_PORT=5432
DB_NAME=telecom_planner
DB_USER=app_user
DB_PASSWORD=local_password
JWT_SECRET=use-a-unique-random-value-at-least-32-characters
ENABLE_LEGACY_PROVIDER_ROUTES=false
ENABLE_LEGACY_SCHEMA_BOOTSTRAP=false
ALLOW_MOCK_PROVIDERS=false
ALLOW_DEMO_SEED=false
DEMO_PASSWORD=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
